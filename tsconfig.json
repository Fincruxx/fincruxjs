{
  "compilerOptions": {
    "resolveJsonModule": true,
    "outDir": "./dist",
    "target": "es2018",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["lib/**/*.ts", "constants/**/*.ts", "interfaces/**/*.ts"],
  "exclude": ["node_modules", "test", "examples", "dist"]
}
